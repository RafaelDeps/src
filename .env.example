# Template de variáveis de ambiente do SRC_ETL.
# Copie para `.env` (gitignored) e preencha. NUNCA commite o `.env`.

# ------------------------------------------------------------------ SRC (ETL autenticado)
# Credenciais do SRC usadas por `src-etl-part` (público-alvo + equipe).
# OPCIONAIS: se ficarem vazias, o ETL busca `src-user`/`src-password` no Infisical
# em runtime (Machine Identity). Os valores do Infisical NUNCA são gravados aqui.
USER=
PASSWORD=

# ------------------------------------------------------------------ Mistral (enriquecimento, opcional)
# Usada por `src-etl-enrich` para preencher "Grande área"/"Área temática" vazias.
MISTRAL_KEY=

# ------------------------------------------------------------------ Infisical (fallback em runtime do ETL)
# Machine Identity (Universal Auth). Quando USER/PASSWORD estiverem vazios acima,
# são OBRIGATÓRIAS: INFISICAL_CLIENT_ID, INFISICAL_CLIENT_SECRET, INFISICAL_PROJECT_ID.
# Precedência: ambiente > .env > padrão.
# Os segredos de origem são fixos (lidos apenas em memória, nunca persistidos):
#   src-user -> USER   |   src-password -> PASSWORD
INFISICAL_HOST=https://app.infisical.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev
INFISICAL_SECRET_PATH=/
